# ─── Minimal HTTP (stdlib urllib, proxy-aware) ───────────────────────────

class HttpStatusError(Exception):
    def __init__(self, code, reason="", url=""):
        self.code = code
        self.status_code = code
        self.url = url
        super().__init__(f"HTTP {code} {reason}".strip())


class _HttpResp:
    def __init__(self, status, body, url=""):
        self.status = status
        self.status_code = status
        self.body = body
        self.url = url

    @property
    def text(self):
        return self.body

    def json(self):
        return json.loads(self.body)

    def raise_for_status(self):
        if self.status >= 400:
            raise HttpStatusError(self.status, self.body[:120], self.url)


_HTTP_OPENER = None


def http_get(url, params=None, timeout=None, headers=None):
    """GET with query params; returns an _HttpResp (raise_for_status is caller's job)."""
    if params:
        sep = "&" if "?" in url else "?"
        url += sep + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers=headers or {})
    try:
        with (_HTTP_OPENER or urllib.request.build_opener()).open(req, timeout=timeout) as resp:
            data = resp.read()
            charset = resp.headers.get_content_charset() or "utf-8"
            return _HttpResp(resp.status, data.decode(charset, errors="replace"), url)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        return _HttpResp(e.code, body, url)


def _download_cover(url):
    """Download a cover image (binary) to COVER_FILE with an atomic rename.

    Returns the local path on success, "" on any failure. Uses the same
    opener as http_get so the configured proxy is honored.
    """
    if not url or not url.startswith(("http://", "https://")):
        return ""
    try:
        req = urllib.request.Request(
            url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"}
        )
        opener = _HTTP_OPENER or urllib.request.build_opener()
        with opener.open(req, timeout=8) as resp:
            data = resp.read()
        if not data:
            return ""
        tmp = COVER_FILE + ".tmp"
        with open(tmp, "wb") as f:
            f.write(data)
        os.rename(tmp, COVER_FILE)
        return COVER_FILE
    except Exception as e:
        log.debug(f"cover download error: {e}")
        return ""


# ─── Minimal WebSocket client (RFC 6455, client side) ────────────────────

class WebSocketError(Exception):
    pass


class WebSocketTimeoutError(WebSocketError):
    pass


class WebSocketClosedError(WebSocketError):
    pass


class WebSocket:
    """Tiny RFC 6455 client: text messages in/out, auto-pong, no fragmentation out."""

    def __init__(self, sock):
        self._sock = sock
        self._buffer = b""

    @staticmethod
    def connect(url, timeout=5):
        parsed = urllib.parse.urlparse(url)
        if parsed.scheme != "ws":
            raise WebSocketError(f"unsupported scheme: {parsed.scheme}")
        host = parsed.hostname or "127.0.0.1"
        port = parsed.port or 80
        path = parsed.path or "/"
        if parsed.query:
            path += "?" + parsed.query
        sock = socket.create_connection((host, port), timeout=timeout)
        try:
            key = base64.b64encode(os.urandom(16)).decode()
            request = (
                f"GET {path} HTTP/1.1\r\n"
                f"Host: {host}:{port}\r\n"
                "Upgrade: websocket\r\n"
                "Connection: Upgrade\r\n"
                f"Sec-WebSocket-Key: {key}\r\n"
                "Sec-WebSocket-Version: 13\r\n\r\n"
            )
            sock.sendall(request.encode())
            data = b""
            while b"\r\n\r\n" not in data:
                chunk = sock.recv(4096)
                if not chunk:
                    raise WebSocketError("connection closed during handshake")
                data += chunk
            head, _, rest = data.partition(b"\r\n\r\n")
            lines = head.decode("latin-1").split("\r\n")
            status = lines[0].split(" ", 2)
            if len(status) < 2 or status[1] != "101":
                raise WebSocketError(f"bad handshake: {lines[0]}")
            accept = base64.b64encode(
                hashlib.sha1(
                    (key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()
                ).digest()
            ).decode()
            headers = {}
            for line in lines[1:]:
                if ":" in line:
                    k, v = line.split(":", 1)
                    headers[k.strip().lower()] = v.strip()
            if headers.get("sec-websocket-accept") != accept:
                raise WebSocketError("bad Sec-WebSocket-Accept")
            ws = WebSocket(sock)
            ws._buffer = rest
            return ws
        except Exception:
            try:
                sock.close()
            except Exception:
                pass
            raise

    def settimeout(self, seconds):
        self._sock.settimeout(seconds)

    def _read_exact(self, n):
        while len(self._buffer) < n:
            try:
                chunk = self._sock.recv(65536)
            except socket.timeout:
                raise WebSocketTimeoutError("recv timeout")
            if not chunk:
                raise WebSocketClosedError("connection closed by peer")
            self._buffer += chunk
        data = self._buffer[:n]
        self._buffer = self._buffer[n:]
        return data

    def _recv_frame(self):
        b1, b2 = self._read_exact(2)
        fin = bool(b1 & 0x80)
        opcode = b1 & 0x0F
        masked = bool(b2 & 0x80)
        length = b2 & 0x7F
        if length == 126:
            length = struct.unpack(">H", self._read_exact(2))[0]
        elif length == 127:
            length = struct.unpack(">Q", self._read_exact(8))[0]
        mask = self._read_exact(4) if masked else None
        payload = self._read_exact(length)
        if mask:
            payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        return fin, opcode, payload

    def recv(self):
        """Return the next complete text message, transparently handling
        ping/pong/close and continuation frames."""
        chunks = []
        while True:
            fin, opcode, payload = self._recv_frame()
            if opcode == 0x9:  # ping -> pong
                self._send_frame(0xA, payload)
                continue
            if opcode == 0xA:  # pong
                continue
            if opcode == 0x8:  # close
                raise WebSocketClosedError("closed by peer")
            if opcode in (0x0, 0x1, 0x2):
                chunks.append(payload)
                if fin:
                    return b"".join(chunks).decode("utf-8", errors="replace")
            else:
                raise WebSocketError(f"unknown opcode {opcode}")

    def send(self, text):
        data = text.encode("utf-8") if isinstance(text, str) else text
        self._send_frame(0x1, data)

    def _send_frame(self, opcode, payload):
        mask = os.urandom(4)
        header = bytearray([0x80 | opcode])
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header += struct.pack(">H", n)
        else:
            header.append(0x80 | 127)
            header += struct.pack(">Q", n)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self._sock.sendall(bytes(header) + mask + masked)

    def close(self):
        try:
            self._sock.close()
        except Exception:
            pass


def _to_float(value, default=0.0):
    """Safe float conversion (JS NaN serializes to null)."""
    try:
        f = float(value)
        if f != f:  # NaN
            return default
        return f
    except (TypeError, ValueError):
        return default


def cache_key(title, artist):
    return f"{artist} - {title}".replace("/", "_").replace(" ", "_")[:120]


def read_cache(title, artist):
    """Load cached LRC if exists."""
    try:
        path = os.path.join(CACHE_DIR, cache_key(title, artist) + ".lrc")
        if os.path.exists(path):
            with open(path) as f:
                lrc = f.read()
            if lrc and re.search(r'\[\d+:', lrc):
                return lrc
    except Exception:
        pass
    return ""


def write_cache(title, artist, lrc):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        path = os.path.join(CACHE_DIR, cache_key(title, artist) + ".lrc")
        with open(path, "w") as f:
            f.write(lrc)
    except Exception as e:
        log.debug(f"write_cache error: {e}")


def read_cached_id(title, artist):
    """Read cached Netease song ID."""
    try:
        path = os.path.join(CACHE_DIR, cache_key(title, artist) + ".id")
        if os.path.exists(path):
            with open(path) as f:
                return f.read().strip()
    except Exception:
        pass
    return None


def write_cached_id(title, artist, sid):
    """Save Netease song ID to cache."""
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        path = os.path.join(CACHE_DIR, cache_key(title, artist) + ".id")
        with open(path, "w") as f:
            f.write(str(sid))
    except Exception:
        pass
