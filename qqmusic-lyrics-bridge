def write_lyrics(text):
    """Atomically write current lyric to the output file."""
    tmp = LYRICS_FILE + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.rename(tmp, LYRICS_FILE)


def write_meta(info):
    tmp = META_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(info, f, ensure_ascii=False)
    os.rename(tmp, META_FILE)


def build_meta(current_line, prev_line, next_line, current_idx, progress,
               position=0.0, duration=0.0, playing=False, total_lines=0,
               title="", artist="", line_start=0.0, char_times=None, char_durs=None,
               line_end=0.0, cover="", cover_ver=0, tl_line="", tl_prev="", tl_next="",
               rom_line="", rom_prev="", rom_next=""):
    """Build the /tmp/lyrics-meta.json dict with a stable field set."""
    return {
        "title": title, "artist": artist, "position": position,
        "duration": duration, "playing": playing, "total_lines": total_lines,
        "current_line": current_line, "prev_line": prev_line,
        "next_line": next_line, "current_idx": current_idx,
        "progress": progress, "line_start": line_start,
        "char_times": char_times or [], "char_durs": char_durs or [],
        "line_end": line_end,
        "cover": cover, "cover_ver": cover_ver,
        "tl_line": tl_line, "tl_prev": tl_prev, "tl_next": tl_next,
        "rom_line": rom_line, "rom_prev": rom_prev, "rom_next": rom_next,
    }


def write_no_song():
    """Clear both output files so the widget stops showing the old song."""
    write_lyrics("No song detected")
    write_meta(build_meta(
        "No song detected", "", "", 0, 0,
        title="", artist="", duration=0, total_lines=0,
    ))


# ─── Shared config ────────────────────────────────────────────────────────

_PLASMOID_CFG_PATH = os.path.expanduser(
    "~/.config/plasma-org.kde.plasma.desktop-appletsrc"
)
_PLASMOID_ID = "com.github.xein.lyrics-osd"

# Cache the parsed appletsrc: it can have hundreds of sections and the main
# loop reads it every iteration. Re-parse at most once per second (or when
# the file changes) so config changes still take effect promptly.
_CFG_CACHE = {"cfg": None, "key": None, "at": 0.0}
_CFG_CACHE_TTL = 1.0


def _load_plasmoid_cfg():
    """Return the parsed appletsrc, re-parsing at most once per second."""
    try:
        st = os.stat(_PLASMOID_CFG_PATH)
        key = (st.st_mtime, st.st_size)
    except OSError:
        key = None
    now = time.time()
    c = _CFG_CACHE
    if c["cfg"] is not None and key == c["key"] and now - c["at"] < _CFG_CACHE_TTL:
        return c["cfg"]
    cfg = configparser.ConfigParser()
    cfg.read(_PLASMOID_CFG_PATH)
    c.update({"cfg": cfg, "key": key, "at": now})
    return cfg


def _find_general_section(cfg=None):
    """Return the lyrics-osd applet's Configuration/General section name, or None."""
    try:
        if cfg is None:
            cfg = _load_plasmoid_cfg()
        applet_id = None
        for sec in cfg.sections():
            if cfg.has_option(sec, "plugin") and cfg.get(sec, "plugin") == _PLASMOID_ID:
                # Section looks like "Containments][172][Applets][329"
                m = re.search(r"Applets\]\[(\d+)\]?$", sec)
                if m:
                    applet_id = m.group(1)
                    break
        if applet_id:
            for sec in cfg.sections():
                if f"Applets][{applet_id}][Configuration][General]" in f"[{sec}]":
                    return sec
    except Exception:
        pass
    return None


def _read_general_option(key, default=None):
    """Read one General option from the lyrics-osd applet config."""
    try:
        cfg = _load_plasmoid_cfg()
        sec = _find_general_section(cfg)
        if sec and cfg.has_option(sec, key):
            return cfg.get(sec, key)
    except Exception:
        pass
    return default


def read_plasmoid_interval():
    """Read refreshInterval from plasmoid's KConfig (if available)."""
    try:
        return int(_read_general_option("refreshInterval"))
    except (TypeError, ValueError):
        return 300


_SOURCE_MAP = ["both", "native", "lrclib", "netease", "lrclib_first", "netease_first"]


def read_plasmoid_lyrics_source():
    """Read lyricsSource from plasmoid's KConfig."""
    try:
        return _SOURCE_MAP[int(_read_general_option("lyricsSource"))]
    except (TypeError, ValueError, IndexError):
        return "both"


def read_plasmoid_player_type():
    """Read playerType from plasmoid's KConfig.

    0=QQMusic (CDP), 1=Netease (stub), 2=Spotify (stub), 3=MoeKoeMusic (WS API).
    """
    try:
        return int(_read_general_option("playerType"))
    except (TypeError, ValueError):
        return 0


def _build_http_opener():
    """Read proxy URL from plasmoid config and build a proxy-aware urllib opener."""
    global _HTTP_OPENER
    try:
        url = (_read_general_option("proxyUrl") or "").strip()
        if url:
            _HTTP_OPENER = urllib.request.build_opener(
                urllib.request.ProxyHandler({"http": url, "https": url})
            )
            log.info(f"Proxy set: {url}")
            return
    except Exception:
        pass
    _HTTP_OPENER = urllib.request.build_opener()


_build_http_opener()


def fetch_lyrics(title, artist):
    """Fetch lyrics based on configured source."""
    if not title:
        return ""
    source = read_plasmoid_lyrics_source()
    log.info(f"  Lyrics source: {source}")

    if source == "lrclib":
        return fetch_lrc(title, artist)
    if source == "netease":
        return fetch_lrc_netease(title, artist)
    if source == "native":
        lrc = read_cache(title, artist)
        if lrc:
            return lrc
        return ""  # fallback to real-time lyric page reading

    if source == "lrclib_first":
        lrc = fetch_lrc(title, artist)
        if lrc:
            return lrc
        return fetch_lrc_netease(title, artist)

    if source == "netease_first":
        lrc = fetch_lrc_netease(title, artist)
        if lrc:
            return lrc
        return fetch_lrc(title, artist)

    # "both" - parallel
    with ThreadPoolExecutor(max_workers=2) as pool:
        futures = {
            pool.submit(fetch_lrc, title, artist): "lrclib",
            pool.submit(fetch_lrc_netease, title, artist): "netease",
        }
        for fut in as_completed(futures):
            try:
                result = fut.result()
                if result:
                    log.info(f"  {futures[fut]}: lyrics found")
                    for f in futures:
                        if not f.done():
                            f.cancel()
                    return result
                log.info(f"  {futures[fut]}: no lyrics")
            except Exception as e:
                log.debug(f"  {futures[fut]} error: {e}")
    return ""


# ─── Main loop ────────────────────────────────────────────────────────────

class LyricsBridge:
    def __init__(self, port, interval=None, moekoe_port=MOEKOE_WS_PORT):
        self.port = port
        self.moekoe_port = moekoe_port
        self.interval = interval or read_plasmoid_interval()
        self.current_title = ""
        self.current_artist = ""
        self.current_duration = 0
        self.parsed_lrc = []
        self.tl_lines = []
        self.rom_lines = []
        self.song_start_time = 0
        self.position = 0
        self.playing = False
        self.last_position_fetch = 0
        self._ws = None
        self._lyric_ws = None
        self._recorded_lrc = []  # [(timestamp, line), ...] for native mode recording
        self._moekoe_ws = None
        self._moekoe_playing = False
        self._moekoe_time = 0.0
        self._moekoe_position = 0.0
        self._moekoe_pos_time = 0
        self._moekoe_logged = False
        self._cover_url = ""
        self._cover_path = ""
        self._cover_ver = 0

    def _connect_lyric_ws(self):
        """Open WS connection to lyric.html for real-time lyrics."""
        self._close_lyric_ws()
        try:
            resp = http_get(f"http://127.0.0.1:{self.port}/json", timeout=3)
            for page in resp.json():
                if page.get("type") == "page" and "lyric.html" in page.get("url", ""):
                    ws = WebSocket.connect(page["webSocketDebuggerUrl"], timeout=5)
                    cdp_call(ws, "Runtime.enable")
                    time.sleep(0.1); ws.settimeout(0.3)
                    while True:
                        try:
                            ws.recv()
                        except Exception:
                            break
                    self._lyric_ws = ws
                    return True
        except Exception:
            pass
        self._lyric_ws = None
        return False

    def _read_lyric_line(self):
        """Read current lyric line from lyric.html."""
        ws = self._lyric_ws
        if not ws:
            return ""
        try:
            result = cdp_call(ws, "Runtime.evaluate", {
                "expression": "(function(){var p=document.body?document.body.innerText.trim():'';var lines=p.split('\\n');for(var i=0;i<lines.length;i++){var t=lines[i].trim();if(t.length>2)return t}return p.substring(0,80)})()",
                "returnByValue": True,
            })
            return result.get("result", {}).get("value", "")
        except Exception:
            self._close_lyric_ws()
            return ""

    def _close_lyric_ws(self):
        if self._lyric_ws:
            try:
                self._lyric_ws.close()
            except Exception:
                pass
            self._lyric_ws = None

    # ─── MoeKoeMusic (WebSocket API) ───────────────────────────────────────

    def _moekoe_connect(self):
        """Connect to MoeKoeMusic's built-in WebSocket API server."""
        self._close_moekoe_ws()
        try:
            ws = WebSocket.connect(
                f"ws://127.0.0.1:{self.moekoe_port}/", timeout=5
            )
            # Short socket timeout keeps the steady-refresh loop responsive;
            # gaps between messages are bridged by wall-clock extrapolation.
            ws.settimeout(0.05)
            return ws
        except Exception as e:
            log.debug(f"moekoe connect error: {e}")
            return None

    def _close_moekoe_ws(self):
        if self._moekoe_ws:
            try:
                self._moekoe_ws.close()
            except Exception:
                pass
            self._moekoe_ws = None

    def _moekoe_recv(self):
        """Drain pending MoeKoeMusic WS messages and return song info or None."""
        ws = self._moekoe_ws
        if not ws:
            return None
        info = None
        deadline = time.time() + 0.06
        while time.time() < deadline:
            try:
                raw = ws.recv()
            except WebSocketTimeoutError:
                break
            except Exception:
                self._close_moekoe_ws()
                break
            try:
                msg = json.loads(raw)
            except (json.JSONDecodeError, TypeError, ValueError):
                continue
            msg_type = msg.get("type")
            data = msg.get("data")
            if msg_type == "lyrics" and isinstance(data, dict):
                # MoeKoeMusic only streams lyrics while playing.
                self._moekoe_playing = True
                self._moekoe_position = _to_float(data.get("currentTime"))
                self._moekoe_pos_time = time.time()
                song = data.get("currentSong") or {}
                info = {
                    "title": str(song.get("name") or "").strip(),
                    "artist": str(song.get("author") or "").strip(),
                    "position": _to_float(data.get("currentTime")),
                    "duration": _to_float(data.get("duration")),
                    "playing": True,
                    "album": str(song.get("album") or "").strip(),
                    "cover": str(song.get("img") or "").strip(),
                    "krc": str(data.get("lyricsData") or ""),
                }
            elif msg_type == "playerState" and isinstance(data, dict):
                self._moekoe_playing = bool(data.get("isPlaying", False))
                self._moekoe_position = _to_float(data.get("currentTime"))
                self._moekoe_pos_time = time.time()
                if info is None and self.current_title:
                    info = {
                        "title": self.current_title,
                        "artist": self.current_artist,
                        "position": self._moekoe_position,
                        "duration": self.current_duration,
                        "playing": self._moekoe_playing,
                        "album": "",
                        "krc": "",
                    }
        if info is not None:
            # The last playerState (or a lyrics message) wins for play state.
            info["playing"] = self._moekoe_playing
        return info

    def _run_moekoe(self):
        """MoeKoeMusic backend: WS events + steady extrapolated meta refresh."""
        if not self._moekoe_ws:
            self._moekoe_ws = self._moekoe_connect()
            if not self._moekoe_ws:
                if not self.current_title:
                    write_no_song()
                _stop.wait(0.5)
                return

        song = self._moekoe_recv()
        if song and song.get("title"):
            krc = song.pop("krc", "")
            source = read_plasmoid_lyrics_source()
            # MoeKoeMusic ships its own synced lyrics (KRC); treat "native"
            # and "both" as KRC, and use KRC as the fallback for "first" modes.
            native = source in ("native", "both")
            self._handle_song(song, skip_fetch=native)

            # Cover art: download once per new URL, bump version for the widget.
            cover_url = song.get("cover", "")
            if cover_url and cover_url != self._cover_url:
                # Async: a slow cover CDN must not block lyric updates on fast
                # track changes.
                self._cover_url = cover_url
                threading.Thread(target=self._fetch_cover_async,
                                 args=(cover_url,), daemon=True).start()

            use_krc = native or (
                source in ("lrclib_first", "netease_first") and not self.parsed_lrc
            )
            if use_krc and krc:
                parsed, self.tl_lines, self.rom_lines = parse_krc_full(krc)
                self.parsed_lrc = parsed

            # Anchor position extrapolation to the freshest reported time so
            # the steady refresh below stays in sync between WS messages.
            self._moekoe_position = self.position
            self._moekoe_pos_time = time.time()
            self._moekoe_playing = self.playing

        if not self.current_title and not self.parsed_lrc:
            if not song or not song.get("title"):
                write_no_song()
            _stop.wait(0.1)
            return

        # Steady refresh: between WS messages, advance position with the wall
        # clock. Line switches and karaoke then track actual playback instead
        # of waiting for the next lyrics message (~270ms cadence).
        if self._moekoe_playing and self._moekoe_pos_time:
            age = time.time() - self._moekoe_pos_time
            # Cap extrapolation: if the app stops pushing messages while
            # playing, re-sync from the next message instead of drifting.
            self.position = self._moekoe_position + min(age, 1.5)
        else:
            self.position = self._moekoe_position

        line = get_current_line(self.parsed_lrc, self.position)
        if not line:
            line = f"{self.current_artist} - {self.current_title}" if self.current_title else "No lyrics"
        write_lyrics(line)

        prev_line = next_line = ""
        current_idx = 0
        line_start = 0.0
        char_times = []
        char_durs = []
        for idx, (ts, text, chars) in enumerate(self.parsed_lrc):
            if ts <= self.position:
                prev_line = "" if idx == 0 else self.parsed_lrc[idx - 1][1]
                next_line = self.parsed_lrc[idx + 1][1] if idx + 1 < len(self.parsed_lrc) else ""
                current_idx = idx
                line_start = ts
                char_times = [round(c[1] - ts, 3) for c in chars]
                char_durs = [round(max(0.01, c[2] - c[1]), 3) for c in chars]
            else:
                break
        tl_line = self.tl_lines[current_idx] if current_idx < len(self.tl_lines) else ""
        tl_prev = self.tl_lines[current_idx - 1] if 0 <= current_idx - 1 < len(self.tl_lines) else ""
        tl_next = self.tl_lines[current_idx + 1] if current_idx + 1 < len(self.tl_lines) else ""
        rom_line = self.rom_lines[current_idx] if current_idx < len(self.rom_lines) else ""
        rom_prev = self.rom_lines[current_idx - 1] if 0 <= current_idx - 1 < len(self.rom_lines) else ""
        rom_next = self.rom_lines[current_idx + 1] if current_idx + 1 < len(self.rom_lines) else ""
        if current_idx + 1 < len(self.parsed_lrc):
            line_end = self.parsed_lrc[current_idx + 1][0]
        else:
            line_end = min(self.current_duration or (line_start + 8.0), line_start + 8.0)
        write_meta(build_meta(
            line, prev_line, next_line, current_idx,
            round(self.position / self.current_duration, 3) if self.current_duration > 0 else 0,
            position=self.position, duration=self.current_duration,
            playing=self._moekoe_playing, total_lines=len(self.parsed_lrc),
            title=self.current_title, artist=self.current_artist,
            line_start=line_start, char_times=char_times, char_durs=char_durs,
            line_end=line_end,
            cover=self._cover_path, cover_ver=self._cover_ver,
            tl_line=tl_line, tl_prev=tl_prev, tl_next=tl_next,
            rom_line=rom_line, rom_prev=rom_prev, rom_next=rom_next,
        ))

        # Steady cadence: honor the configured refresh interval.
        _stop.wait(max(0.05, self.interval / 1000.0))

    def _fetch_cover_async(self, url):
        path = _download_cover(url)
        if path:
            self._cover_path = path
            self._cover_ver += 1
        else:
            self._cover_url = ""  # allow retry on next message

    def _check_clear_cache(self):
        """Check if clearCache flag is set in plasmoid config."""
        try:
            cfg = _load_plasmoid_cfg()
            sec = _find_general_section(cfg)
            if sec and cfg.has_option(sec, "clearCache") and cfg.getboolean(sec, "clearCache"):
                log.info("Clearing lyrics cache...")
                for f in os.listdir(CACHE_DIR):
                    if f.endswith(".lrc") or f.endswith(".id"):
                        os.remove(os.path.join(CACHE_DIR, f))
                cfg.set(sec, "clearCache", "false")
                with open(_PLASMOID_CFG_PATH, "w") as f:
                    cfg.write(f)
                _CFG_CACHE["cfg"] = None  # invalidate; file just changed
                log.info(f"Cache cleared ({CACHE_DIR})")
        except Exception as e:
            log.debug(f"clear cache error: {e}")

    def _connect_cdp(self):
        """Open or reopen CDP WebSocket connection."""
        self._close_ws()
        ws_url = get_ws_url(self.port)
        if not ws_url:
            self._ws = None
            return False
        try:
            ws = WebSocket.connect(ws_url, timeout=5)
            # Enable Runtime once
            cdp_call(ws, "Runtime.enable")
            time.sleep(0.1)
            # Flush initial events
            ws.settimeout(0.3)
            while True:
                try:
                    ws.recv()
                except Exception:
                    break
            self._ws = ws
            return True
        except Exception:
            self._ws = None
            return False

    def _close_ws(self):
        if self._ws:
            try:
                self._ws.close()
            except Exception:
                pass
            self._ws = None

    def _extract(self):
        """Read current song info from persistent CDP connection."""
        ws = self._ws
        if not ws:
            return None

        info = {"title": "", "artist": "", "position": 0, "duration": 0, "playing": False}

        try:
            # Audio element
            result = cdp_call(ws, "Runtime.evaluate", {
                "expression": """
                    (function() {
                        var audios = document.querySelectorAll('audio');
                        for (var i = 0; i < audios.length; i++) {
                            if (audios[i].duration > 0) return JSON.stringify({
                                currentTime: audios[i].currentTime,
                                duration: audios[i].duration,
                                paused: audios[i].paused
                            });
                        }
                        return '';
                    })()
                """,
                "returnByValue": True,
            })
            audio_data = result.get("result", {}).get("value", "")
            if audio_data:
                try:
                    ad = json.loads(audio_data)
                    info["position"] = ad.get("currentTime", 0)
                    info["duration"] = ad.get("duration", 0)
                    info["playing"] = not ad.get("paused", True)
                except (json.JSONDecodeError, TypeError):
                    pass

            # Song title/artist
            result = cdp_call(ws, "Runtime.evaluate", {
                "expression": """
                    (function() {
                        var el = document.querySelector('.player_cont');
                        if (!el) return '';
                        var text = (el.innerText || el.textContent || '').trim();
                        text = text.replace(/\\d{1,2}:\\d{2}\\/\\d{1,2}:\\d{2}/g, '').trim();
                        text = text.replace(/\\s+\\d+$/, '').trim();
                        if (text.includes('-') && text.length > 3 && text.length < 120) return text;
                        return '';
                    })()
                """,
                "returnByValue": True,
            })
            meta_val = result.get("result", {}).get("value", "")
            if meta_val:
                if " -" in meta_val:
                    parts = meta_val.rsplit(" -", 1)
                    info["title"] = parts[0].strip()
                    info["artist"] = parts[1].strip()
                else:
                    info["title"] = meta_val

            # Album name (look near the player area for better search matching)
            result = cdp_call(ws, "Runtime.evaluate", {
                "expression": """
                    (function() {
                        var text = document.body ? document.body.innerText : '';
                        var m = text.match(/[\\u4e00-\\u9fff]+《[^》]+》/);
                        return m ? m[0] : '';
                    })()
                """,
                "returnByValue": True,
            })
            info["album"] = result.get("result", {}).get("value", "")

            # Album name (look near the player area)
            result = cdp_call(ws, "Runtime.evaluate", {
                "expression": """
                    (function() {
                        var el = document.querySelector('.player_cont');
                        if (!el) return '';
                        var body = document.body ? document.body.innerText : '';
                        var idx = body.indexOf(el.innerText.substring(0, 20));
                        if (idx < 0) return '';
                        // Search around current song for album pattern
                        var area = body.substring(Math.max(0, idx - 200), idx + 50);
                        var m = area.match(/[\\u4e00-\\u9fff]+《[^》]+》/);
                        return m ? m[0] : '';
                    })()
                """,
                "returnByValue": True,
            })
            info["album"] = result.get("result", {}).get("value", "")

            return info
        except Exception as e:
            log.debug(f"extract error: {e}")
            self._close_ws()
            return None

    def run(self):
        log.info(f"Lyrics bridge started (CDP port: {self.port}, "
                 f"MoeKoeMusic WS port: {self.moekoe_port}, interval: {self.interval}ms)")
        log.info(f"Writing to: {LYRICS_FILE}")

        while not _stop.is_set():
            try:
                self._check_clear_cache()

                # Player type: 0=QQMusic(CDP), 1=Netease(stub), 2=Spotify(stub),
                #              3=MoeKoeMusic(WebSocket API)
                player_type = read_plasmoid_player_type()
                if player_type == 3:
                    if not self._moekoe_logged:
                        log.info(f"Player type 3: MoeKoeMusic (ws://127.0.0.1:{self.moekoe_port}/)")
                        self._moekoe_logged = True
                    self._run_moekoe()
                    continue
                self._moekoe_logged = False
                if player_type != 0:
                    if not self.current_title:
                        log.info(f"Player type {player_type}: not implemented")
                        write_no_song()
                    _stop.wait(3)
                    continue

                # Ensure CDP connection
                if not self._ws:
                    if not self._connect_cdp():
                        if not self.current_title:
                            write_no_song()
                        _stop.wait(max(0.05, self.interval / 1000.0))
                        continue

                # Ensure lyric page connection (only for native source)
                source = read_plasmoid_lyrics_source()
                if source == "native" and not self._lyric_ws:
                    self._connect_lyric_ws()

                song = self._extract()
                if song and song.get("title"):
                    self._handle_song(song)
                    # Real-time lyric from QQ Music's own page (native mode, no cache)
                    if source == "native" and not self.parsed_lrc:
                        line = self._read_lyric_line()
                        if line and self.current_title:
                            write_lyrics(line)
                            # Record lyric line for LRC generation (native mode)
                            if not self._recorded_lrc or self._recorded_lrc[-1][1] != line:
                                # If line looks like a different song's metadata, force re-extract
                                if (len(line) < 40 and " - " in line and
                                    self.current_title not in line and
                                    self.current_artist not in line):
                                    self.current_title = ""  # force song re-detection
                                else:
                                    self._recorded_lrc.append((self.position, line))
                            write_meta({
                                "title": self.current_title,
                                "artist": self.current_artist,
                                "position": self.position,
                                "duration": self.current_duration, "playing": True,
                                "total_lines": 1,
                                "current_line": line,
                                "prev_line": "",
                                "next_line": "",
                                "current_idx": 0,
                                "progress": round(self.position / self.current_duration, 3) if self.current_duration > 0 else 0,
                            })
                elif not self.current_title:
                    write_no_song()
                    _stop.wait(max(0.05, self.interval / 1000.0))
                else:
                    # Already showing a song, just retry faster
                    _stop.wait(max(0.05, self.interval / 1000.0))
            except Exception as e:
                log.error(f"Error: {e}")
                self._close_ws()
                _stop.wait(max(0.05, self.interval / 1000.0))

    def _handle_song(self, song, skip_fetch=False):
        global _current_album
        title = song.get("title", "")
        artist = song.get("artist", "")
        album = song.get("album", "")
        if album:
            _current_album = album
        position = song.get("position", 0)
        playing = song.get("playing", False)
        duration = song.get("duration", 0)
        self.current_duration = duration if duration > 0 else self.current_duration

        # Save recorded LRC from native mode when song changes
        song_id = f"{artist} - {title}"
        if song_id != f"{self.current_artist} - {self.current_title}":
            if self._recorded_lrc and self.current_title and len(self._recorded_lrc) >= 3:
                existing = read_cache(self.current_title, self.current_artist)
                if not existing:
                    lrc_text = ""
                    for ts, line in self._recorded_lrc:
                        mins = int(ts // 60)
                        secs = ts % 60
                        lrc_text += f"[{mins:02d}:{secs:05.2f}]{line}\n"
                    if lrc_text:
                        write_cache(self.current_title, self.current_artist, lrc_text)
                        log.info(f"  Saved recorded LRC: {len(self._recorded_lrc)} lines")
            self._recorded_lrc = []
            log.info(f"Now playing: {artist} - {title}")
            self.current_title = title
            self.current_artist = artist
            self.parsed_lrc = []
            self.tl_lines = []
            self.rom_lines = []
            self.song_start_time = time.time() - position

            # Write fallback immediately (new song title) so the widget reacts
            # instantly; the real lyric line overwrites it moments later.
            source = read_plasmoid_lyrics_source()
            write_lyrics(f"{artist} - {title}" if title else "No lyrics")
            write_meta(build_meta(
                f"{artist} - {title}" if title else "No lyrics", "", "", 0, 0,
                position=position, duration=duration, playing=playing,
                title=title, artist=artist,
                cover=self._cover_path, cover_ver=self._cover_ver,
            ))

            # Background lyrics fetch (don't block the main loop)
            if not skip_fetch:
                threading.Thread(target=self._fetch_lyrics_async,
                                 args=(title, artist, album), daemon=True).start()

        self.playing = playing

        # Get position: prefer explicit position (CDP audio / WS currentTime),
        # else infer from start time; freeze when paused.
        if position > 0:
            self.position = position
        elif playing:
            self.position = time.time() - self.song_start_time
        else:
            self.position = max(0, self.position)

        # Skip final writes in native mode if no cached LRC
        source = read_plasmoid_lyrics_source()
        if source != "native" or self.parsed_lrc:
            line = get_current_line(self.parsed_lrc, self.position)
            if not line:
                line = f"{self.current_artist} - {self.current_title}" if self.current_title else "No lyrics"
            write_lyrics(line)

            # Build lyric context
            prev_line = ""
            next_line = ""
            current_idx = 0
            line_start = 0.0
            char_times = []
            char_durs = []
            for idx, (ts, text, chars) in enumerate(self.parsed_lrc):
                if ts <= self.position:
                    prev_line = "" if idx == 0 else self.parsed_lrc[idx - 1][1] if idx > 0 else ""
                    next_line = self.parsed_lrc[idx + 1][1] if idx + 1 < len(self.parsed_lrc) else ""
                    current_idx = idx
                    line_start = ts
                    char_times = [round(c[1] - ts, 3) for c in chars]
                    char_durs = [round(max(0.01, c[2] - c[1]), 3) for c in chars]
                else:
                    break

            progress = self.position / duration if duration > 0 else 0
            tl_line = self.tl_lines[current_idx] if current_idx < len(self.tl_lines) else ""
            tl_prev = self.tl_lines[current_idx - 1] if 0 <= current_idx - 1 < len(self.tl_lines) else ""
            tl_next = self.tl_lines[current_idx + 1] if current_idx + 1 < len(self.tl_lines) else ""
            rom_line = self.rom_lines[current_idx] if current_idx < len(self.rom_lines) else ""
            rom_prev = self.rom_lines[current_idx - 1] if 0 <= current_idx - 1 < len(self.rom_lines) else ""
            rom_next = self.rom_lines[current_idx + 1] if current_idx + 1 < len(self.rom_lines) else ""
            if current_idx + 1 < len(self.parsed_lrc):
                line_end = self.parsed_lrc[current_idx + 1][0]
            else:
                line_end = min(duration or (line_start + 8.0), line_start + 8.0)
            write_meta(build_meta(
                line, prev_line, next_line, current_idx, round(progress, 3),
                position=self.position, duration=duration,
                playing=self.playing, total_lines=len(self.parsed_lrc),
                title=self.current_title, artist=self.current_artist,
                line_start=line_start, char_times=char_times, char_durs=char_durs,
                line_end=line_end,
                cover=self._cover_path, cover_ver=self._cover_ver,
                tl_line=tl_line, tl_prev=tl_prev, tl_next=tl_next,
                rom_line=rom_line, rom_prev=rom_prev, rom_next=rom_next,
            ))

    def _fetch_lyrics_async(self, title, artist, album=""):
        """Background lyrics fetch. Updates parsed_lrc when done."""
        lrc = read_cache(title, artist)
        if lrc:
            log.info("  Cache hit")
            if self.current_title == title and self.current_artist == artist:
                self.parsed_lrc = parse_lrc(lrc)
                log.info(f"  Lyrics: {len(self.parsed_lrc)} lines")
            return
        lrc = fetch_lyrics(title, artist)
        if lrc:
            write_cache(title, artist, lrc)
            if self.current_title == title and self.current_artist == artist:
                self.parsed_lrc = parse_lrc(lrc)
                log.info(f"  Lyrics: {len(self.parsed_lrc)} lines")
        else:
            log.info("  No lyrics found")


def main():
    parser = argparse.ArgumentParser(description="Music Lyrics Bridge")
    parser.add_argument("--debug-port", type=int, default=DEBUG_PORT)
    parser.add_argument("--moekoe-port", type=int, default=MOEKOE_WS_PORT,
                        help="MoeKoeMusic WebSocket API port (default: 6520)")
    parser.add_argument("--interval", type=int, default=None,
                        help="Poll interval in ms (default: read from plasmoid config or 300)")
    args = parser.parse_args()

    bridge = LyricsBridge(args.debug_port, interval=args.interval,
                          moekoe_port=args.moekoe_port)
    try:
        bridge.run()
    except KeyboardInterrupt:
        log.info("Shutting down...")
        _stop.set()
        write_lyrics("")


if __name__ == "__main__":
    main()
