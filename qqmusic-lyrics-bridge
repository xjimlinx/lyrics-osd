"""
QQ Music Lyrics Bridge
Connects to QQ Music via Chrome DevTools Protocol, extracts playback info,
fetches synced lyrics from lrclib.net, and writes the current lyric line
to /tmp/lyrics-current.txt for a plasmoid to display.

Usage:
  ./qqmusic-lyrics-bridge [--debug-port PORT]
"""

import json
import os
import time
import re
import argparse
import logging
import threading
import configparser
