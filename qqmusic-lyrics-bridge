    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%H:%M:%S",
)
log = logging.getLogger("qqmusic-lyrics")

DEBUG_PORT = 9223
LYRICS_FILE = "/tmp/lyrics-current.txt"
META_FILE = "/tmp/lyrics-meta.json"
CACHE_DIR = os.path.expanduser("~/.cache/lyrics-osd")
_current_album = ""


def cache_key(title, artist):
    return f"{artist} - {title}".replace("/", "_").replace(" ", "_")[:120]


def read_cache(title, artist):
    """Load cached LRC if exists."""
    try:
        path = os.path.join(CACHE_DIR, cache_key(title, artist) + ".lrc")
        if os.path.exists(path):
            with open(path) as f:
                lrc = f.read()
            if lrc and re.search(r'\[\d+:', lrc):
                return lrc
    except Exception:
        pass
    return ""


def write_cache(title, artist, lrc):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        path = os.path.join(CACHE_DIR, cache_key(title, artist) + ".lrc")
        with open(path, "w") as f:
            f.write(lrc)
    except Exception as e:
        log.debug(f"write_cache error: {e}")


def read_cached_id(title, artist):
    """Read cached Netease song ID."""
    try:
        path = os.path.join(CACHE_DIR, cache_key(title, artist) + ".id")
        if os.path.exists(path):
            with open(path) as f:
                return f.read().strip()
    except Exception:
        pass
    return None


def write_cached_id(title, artist, sid):
    """Save Netease song ID to cache."""
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        path = os.path.join(CACHE_DIR, cache_key(title, artist) + ".id")
        with open(path, "w") as f:
            f.write(str(sid))
    except Exception:
        pass
CACHE_DIR = os.path.expanduser("~/.cache/lyrics-osd")

