# ─── CDP helpers ──────────────────────────────────────────────────────────

def get_ws_url(port):
    try:
        resp = http_get(f"http://127.0.0.1:{port}/json", timeout=3)
        # Prefer index.html (main player page with song info)
        for page in resp.json():
            if page.get("type") == "page" and "index.html" in page.get("url", ""):
                return page["webSocketDebuggerUrl"]
        # Fallback: any page
        for page in resp.json():
            if page.get("type") == "page":
                return page["webSocketDebuggerUrl"]
    except Exception:
        pass
    return None


def cdp_call(ws, method, params=None):
    """Send a CDP command and wait for a result. Ignores non-matching events."""
    msg_id = _next_msg_id()
    msg = json.dumps({
        "id": msg_id,
        "method": method,
        "params": params or {},
    })
    ws.send(msg)
    ws.settimeout(5)
    deadline = time.time() + 5
    while time.time() < deadline:
        try:
            raw = ws.recv()
        except (WebSocketTimeoutError, OSError):
            break
        except Exception:
            continue
        try:
            resp = json.loads(raw)
        except (json.JSONDecodeError, ValueError):
            continue
        if resp.get("id") == msg_id:
            return resp.get("result", {})
    return {}


def cdp_send_only(ws, method, params=None):
    ws.send(json.dumps({
        "id": _next_msg_id(),
        "method": method,
        "params": params or {},
    }))


# ─── Lyrics fetching ─────────────────────────────────────────────────────

def fetch_lrc(title, artist):
    """Fetch synced LRC from lrclib.net."""
    if not title:
        return ""
    try:
        params = {"track_name": title}
        if artist:
            params["artist_name"] = artist
        resp = http_get(
            "https://lrclib.net/api/search",
            params=params,
            timeout=15,
        )
        resp.raise_for_status()
        data = resp.text
        if not data:
            log.debug("  lrclib: empty response")
            return ""
        tracks = json.loads(data)
        for t in tracks:
            lrc = (t.get("syncedLyrics") or "").strip()
            if lrc and re.search(r'\[\d+:', lrc):
                return lrc
        # Fallback: plain lyrics
        for t in tracks:
            lrc = (t.get("plainLyrics") or "").strip()
            if lrc:
                return lrc
        return ""
    except Exception as e:
        log.debug(f"fetch_lrc error: {e}")
        return ""


def fetch_lrc_netease(title, artist, album=""):
    """Fetch synced LRC from Meting API (search via direct Netease API)."""
    global _current_album
    if not title:
        return ""

    # Step 1: Get song ID (cached ID first, then search)
    sid = read_cached_id(title, artist)
    if not sid:
        sid = _search_netease_id(title, artist, album or _current_album)
    if sid:
        try:
            r = http_get(
                "https://api.injahow.cn/meting/",
                params={"type": "lrc", "server": "netease", "id": sid},
                timeout=15,
            )
            r.raise_for_status()
            lrc = r.text.strip()
            if lrc and re.search(r'\[\d+:', lrc):
                write_cached_id(title, artist, sid)
                return lrc
        except Exception as e:
            log.debug(f"meting lrc error: {e}")

    # Fallback: try the Vercel proxy
    headers = {"User-Agent": "Mozilla/5.0", "Referer": "https://music.163.com/"}
    lrc = _fetch_via_proxy(title, artist, headers)
    if lrc:
        return lrc

    # Last resort: direct Netease API
    return _fetch_via_direct(title, artist, headers)


def _search_netease_id(title, artist, album=""):
    """Search Netease and return the best matching song ID."""
    try:
        keyword = f"{title} {artist} {album}" if album else f"{title} {artist}"
        r = http_get(
            "https://music.163.com/api/search/get",
            params={"s": keyword, "type": 1, "limit": 10},
            headers={"User-Agent": "Mozilla/5.0", "Referer": "https://music.163.com/"},
            timeout=10,
        )
        r.raise_for_status()
        songs = (r.json().get("result", {}) or {}).get("songs", [])
        if not songs:
            return None

        best = None
        for s in songs:
            sname = s.get("name", "")
            sartist_list = [a.get("name", "").lower() for a in s.get("artists", [])]
            artist_lower = artist.lower() if artist else ""

            # Require: song title matches AND at least one artist matches
            title_ok = sname.lower() == title.lower() or title.lower() in sname.lower()
            artist_ok = not artist or any(artist_lower in a or a in artist_lower for a in sartist_list)

            if title_ok and artist_ok:
                # Prefer exact title match over substring
                if sname.lower() == title.lower():
                    return s.get("id")
                best = s.get("id")

            # Also try substring match on artist
            if not best and title.lower() in sname.lower() and artist_ok:
                best = s.get("id")

        return best or songs[0].get("id")
    except Exception as e:
        log.debug(f"search netease error: {e}")
    return None


def _fetch_via_proxy(title, artist, headers):
    """Try Netease Cloud Music via public API proxy."""
    try:
        proxy = "https://netease-cloud-music-api-eta.vercel.app"
        r = http_get(f"{proxy}/search", params={"keywords": f"{title} {artist}", "limit": 5}, timeout=25)
        r.raise_for_status()
        songs = (r.json().get("result", {}) or {}).get("songs", [])
        if not songs:
            log.debug(f"netease proxy: no search results for '{title} {artist}'")
            return ""
        sid = songs[0].get("id")
        if not sid:
            return ""
        r2 = http_get(f"{proxy}/lyric", params={"id": sid}, timeout=25)
        r2.raise_for_status()
        d = r2.json()
        lrc = (d.get("lrc", {}) or {}).get("lyric", "")
        if lrc and re.search(r'\[\d+:', lrc):
            return lrc
        log.debug(f"netease proxy: lyric empty for id={sid}, keys={list(d.keys())}")
        return ""
    except Exception as e:
        log.debug(f"netease proxy error: {e}")
        return ""


def _fetch_via_direct(title, artist, headers):
    """Try Netease Cloud Music via direct API (fallback)."""
    try:
        keyword = f"{title} {artist}" if artist else title
        r = http_get(
            "https://music.163.com/api/search/get",
            params={"s": keyword, "type": 1, "limit": 5},
            headers=headers, timeout=6,
        )
        r.raise_for_status()
        songs = (r.json().get("result", {}) or {}).get("songs", [])
        if not songs:
            return ""
        sid = songs[0].get("id")
        if not sid:
            return ""
        r2 = http_get(
            f"https://music.163.com/api/song/lyric?id={sid}&lv=1&kv=1&tv=-1",
            headers=headers, timeout=6,
        )
        r2.raise_for_status()
        d = r2.json()
        lrc = (d.get("lrc", {}) or {}).get("lyric", "")
        if lrc and re.search(r'\[\d+:', lrc):
            return lrc
        return ""
    except Exception as e:
        log.debug(f"netease direct error: {e}")
        return ""


def parse_lrc(lrc_text):
    """Parse LRC format: [mm:ss.xx]text -> [(time_sec, text, []), ...] sorted.

    Returns the same (time, text, chars) triple shape as parse_krc(); LRC has
    no character-level timings, so chars is always empty.
    """
    lines = []
    pattern = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\](.*)")
    for line in lrc_text.strip().split("\n"):
        m = pattern.match(line)
        if m:
            mins = int(m.group(1))
            secs = float(m.group(2))
            text = m.group(3).strip()
            if text:
                lines.append((mins * 60 + secs, text, []))
    lines.sort()
    return lines


def _decode_krc_language(code):
    """Decode KRC [language:base64] JSON into translation/romanization maps.

    KuGou KRC files carry extra language tracks in a base64-encoded JSON
    header: content sections with type==1 are translations and type==0 are
    romanizations, each an array indexed by lyric line. Returns
    (translations, romanizations) dicts {line_index: text}.
    """
    translations = {}
    romanizations = {}
    try:
        cleaned = re.sub(r"[^A-Za-z0-9+/=]", "", code)
        padded = cleaned + "=" * ((4 - len(cleaned) % 4) % 4)
        data = json.loads(base64.b64decode(padded).decode("utf-8", "replace"))
        content = (data.get("content") or []) if isinstance(data, dict) else []
        for section in content:
            if not isinstance(section, dict):
                continue
            track = section.get("lyricContent")
            if not isinstance(track, list):
                continue
            if section.get("type") in (1, "1"):
                for idx, entry in enumerate(track):
                    if isinstance(entry, (list, tuple)) and entry and entry[0]:
                        translations[idx] = entry[0]
            elif section.get("type") in (0, "0"):
                for idx, entry in enumerate(track):
                    if isinstance(entry, list):
                        text = "".join(str(x) for x in entry)
                        if text:
                            romanizations[idx] = text
    except Exception as e:
        log.debug(f"krc language decode error: {e}")
    return translations, romanizations


def parse_krc_full(krc_text):
    """Parse KRC (MoeKoeMusic / KuGou) into lines plus translation tracks.

    Returns (lines, translations, romanizations): lines has the same shape as
    parse_krc(); the two extra lists are per-line strings aligned to it ("").
    """
    lines = []
    translations = []
    romanizations = []
    tl_map = {}
    rom_map = {}
    offset_ms = 0
    pattern = re.compile(r"^\[(\d+),(\d+)\](.*)$")
    char_re = re.compile(r"<(\d+),(\d+),\d+>([^<]+)")
    for raw in krc_text.splitlines():
        line = raw.strip()
        if not line:
            continue
        m = re.match(r"^\[offset:(-?\d+)\]$", line)
        if m:
            offset_ms = int(m.group(1))
            continue
        m = re.match(r"^\[language:(.*)\]$", line)
        if m:
            tl_map, rom_map = _decode_krc_language(m.group(1))
            continue
        m = pattern.match(line)
        if not m:
            continue  # skip metadata like [ti:...] [ar:...] [hash:...]
        start_ms = int(m.group(1)) + offset_ms
        text = re.sub(r"<\d+,\d+,\d+>", "", m.group(3)).strip()
        if text:
            chars = _expand_krc_chars(m.group(3), start_ms, int(m.group(2)))
            idx = len(lines)
            lines.append((start_ms / 1000.0, text, chars))
            translations.append(tl_map.get(idx, ""))
            romanizations.append(rom_map.get(idx, ""))
    lines.sort(key=lambda x: x[0])
    # Re-align the extra tracks after sorting (rare, but keep them consistent).
    if translations or romanizations:
        order = sorted(range(len(lines)), key=lambda i: lines[i][0])
        translations = [translations[i] for i in order]
        romanizations = [romanizations[i] for i in order]
    return lines, translations, romanizations


def parse_krc(krc_text):
    """Parse KRC format (MoeKoeMusic / KuGou): [start_ms,duration_ms]text.

    Returns [(time_sec, text, chars), ...] where chars is a list of
    (char_block, start_sec, end_sec) triples with absolute timestamps.
    Lines without character-level tags get an empty chars list.
    """
    return parse_krc_full(krc_text)[0]


def _expand_krc_chars(content, start_ms, line_dur_ms):
    """Expand a KRC line into one (char, start_sec, end_sec) per character.

    Tagged blocks contribute their own timings; untagged gaps (rare) are
    spread evenly between the neighbouring tagged blocks so the resulting
    list always matches the visible text length.
    """
    chars = []
    line_start = start_ms / 1000.0
    line_end = (start_ms + line_dur_ms) / 1000.0
    char_re = re.compile(r"<(\d+),(\d+),\d+>([^<]+)")
    matches = list(char_re.finditer(content))

    def spread(frag, frag_start, frag_end):
        n = len(frag)
        for i in range(n):
            if n > 1:
                s = frag_start + (frag_end - frag_start) * i / n
                e = frag_start + (frag_end - frag_start) * (i + 1) / n
            else:
                s, e = frag_start, frag_end
            chars.append((frag[i], round(s, 3), round(e, 3)))

    if not matches:
        spread(content, line_start, line_end)
        return chars

    cursor = 0
    prev_end = line_start
    for cm in matches:
        off = int(cm.group(1))
        dur = int(cm.group(2))
        block_start = (start_ms + off) / 1000.0
        block_end = block_start + dur / 1000.0
        if cm.start() > cursor:
            spread(content[cursor:cm.start()], prev_end, block_start)
        spread(cm.group(3), block_start, block_end)
        prev_end = block_end
        cursor = cm.end()
    if cursor < len(content):
        spread(content[cursor:], prev_end, line_end)
    return chars


def get_current_line(parsed_lrc, position):
    """Return the last line with timestamp <= position, or first line."""
    if not parsed_lrc:
        return ""
    current = parsed_lrc[0][1]
    for ts, text, _ in parsed_lrc:
        if ts <= position:
            current = text
        else:
            break
    return current


