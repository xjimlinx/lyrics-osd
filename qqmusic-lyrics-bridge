# ─── CDP helpers ──────────────────────────────────────────────────────────

def get_ws_url(port):
    try:
        resp = _HTTP.get(f"http://127.0.0.1:{port}/json", timeout=3)
        # Prefer index.html (main player page with song info)
        for page in resp.json():
            if page.get("type") == "page" and "index.html" in page.get("url", ""):
                return page["webSocketDebuggerUrl"]
        # Fallback: any page
        for page in resp.json():
            if page.get("type") == "page":
                return page["webSocketDebuggerUrl"]
    except Exception:
        pass
    return None


def cdp_call(ws, method, params=None):
    """Send a CDP command and wait for a result. Ignores non-matching events."""
    msg_id = int(time.time() * 1000) % 100000
    msg = json.dumps({
        "id": msg_id,
        "method": method,
        "params": params or {},
    })
    ws.send(msg)
    ws.settimeout(5)
    deadline = time.time() + 5
    while time.time() < deadline:
        try:
            raw = ws.recv()
        except (websocket.WebSocketTimeoutException, OSError):
            break
        except Exception:
            continue
        try:
            resp = json.loads(raw)
        except (json.JSONDecodeError, ValueError):
            continue
        if resp.get("id") == msg_id:
            return resp.get("result", {})
    return {}


def cdp_send_only(ws, method, params=None):
    ws.send(json.dumps({
        "id": int(time.time() * 1000) % 100000,
        "method": method,
        "params": params or {},
    }))


# ─── Song extraction ─────────────────────────────────────────────────────

def extract_song(port):
    """Get current song info + playback state from QQ Music via CDP."""
    ws_url = get_ws_url(port)
    if not ws_url:
        return None
    try:
        ws = websocket.create_connection(ws_url, timeout=5)
    except Exception:
        return None

    info = {"title": "", "artist": "", "position": 0, "duration": 0, "playing": False}

    try:
        # Enable Runtime (must wait for response, don't skip it)
        cdp_call(ws, "Runtime.enable")
        time.sleep(0.1)

        # Flush any pending console events by reading with short timeout
        ws.settimeout(0.3)
        flushed = 0
        while flushed < 50:
            try:
                raw = ws.recv()
                flushed += 1
            except Exception:
                break

        # Get audio position/duration/paused from audio elements
        result = cdp_call(ws, "Runtime.evaluate", {
            "expression": """
                (function() {
                    var audios = document.querySelectorAll('audio');
                    for (var i = 0; i < audios.length; i++) {
                        if (audios[i].duration > 0) {
                            return JSON.stringify({
                                currentTime: audios[i].currentTime,
                                duration: audios[i].duration,
                                paused: audios[i].paused
                            });
                        }
                    }
                    return '';
                })()
            """,
            "returnByValue": True,
        })
        audio_data = result.get("result", {}).get("value", "")
        if audio_data:
            try:
                ad = json.loads(audio_data)
                info["position"] = ad.get("currentTime", 0)
                info["duration"] = ad.get("duration", 0)
                info["playing"] = not ad.get("paused", True)
            except (json.JSONDecodeError, TypeError):
                pass

        # Get song title/artist from QQ Music's .player_cont element
        # Format: "song_name -artist_name HH:MM/HH:MM"
        result = cdp_call(ws, "Runtime.evaluate", {
            "expression": """
                (function() {
                    var el = document.querySelector('.player_cont');
                    if (!el) return '';
                    var text = (el.innerText || el.textContent || '').trim();
                    // Remove time patterns like "02:10/02:53"
                    text = text.replace(/\\d{1,2}:\\d{2}\\/\\d{1,2}:\\d{2}/g, '').trim();
                    // Remove trailing digits (playlist count like "59")
                    text = text.replace(/\\s+\\d+$/, '').trim();
                    // Check for "song -artist" pattern
                    if (text.includes('-') && text.length > 3 && text.length < 120) {
                        return text;
                    }
                    return '';
                })()
            """,
            "returnByValue": True,
        })
        meta_val = result.get("result", {}).get("value", "")
        if meta_val:
            title = meta_val.strip()
            # Parse "song -artist" using LAST occurrence of " -"
            # e.g. "Merry Christmas Mr. Lawrence - FYI -Utada" -> song + artist
            if " -" in title:
                parts = title.rsplit(" -", 1)
                info["title"] = parts[0].strip()
                info["artist"] = parts[1].strip()
            else:
                info["title"] = title

        return info
    except Exception as e:
        log.debug(f"extract_song error: {e}")
        return None
    finally:
        try:
            ws.close()
        except Exception:
            pass


# ─── Lyrics fetching ─────────────────────────────────────────────────────

def fetch_lrc(title, artist):
    """Fetch synced LRC from lrclib.net."""
    if not title:
        return ""
    try:
        params = {"track_name": title}
        if artist:
            params["artist_name"] = artist
        resp = _HTTP.get(
            "https://lrclib.net/api/search",
            params=params,
            timeout=15,
        )
        resp.raise_for_status()
        data = resp.text
        if not data:
            log.debug("  lrclib: empty response")
            return ""
        tracks = json.loads(data)
        for t in tracks:
            lrc = (t.get("syncedLyrics") or "").strip()
            if lrc and re.search(r'\[\d+:', lrc):
                return lrc
        # Fallback: plain lyrics
        for t in tracks:
            lrc = (t.get("plainLyrics") or "").strip()
            if lrc:
                return lrc
        return ""
    except Exception as e:
        log.debug(f"fetch_lrc error: {e}")
        return ""


def fetch_lrc_netease(title, artist, album=""):
    """Fetch synced LRC from Meting API (search via direct Netease API)."""
    global _current_album
    if not title:
        return ""

    # Step 1: Get song ID (cached ID first, then search)
    sid = read_cached_id(title, artist)
    if not sid:
        sid = _search_netease_id(title, artist, album or _current_album)
    if sid:
        try:
            r = _HTTP.get(
                "https://api.injahow.cn/meting/",
                params={"type": "lrc", "server": "netease", "id": sid},
            timeout=15,
            )
            r.raise_for_status()
            lrc = r.text.strip()
            if lrc and re.search(r'\[\d+:', lrc):
                write_cached_id(title, artist, sid)
                return lrc
        except Exception as e:
            log.debug(f"meting lrc error: {e}")

    # Fallback: try the Vercel proxy
    headers = {"User-Agent": "Mozilla/5.0", "Referer": "https://music.163.com/"}
    lrc = _fetch_via_proxy(title, artist, headers)
    if lrc:
        return lrc

    # Last resort: direct Netease API
    return _fetch_via_direct(title, artist, headers)


def _search_netease_id(title, artist, album=""):
    """Search Netease and return the best matching song ID."""
    try:
        keyword = f"{title} {artist} {album}" if album else f"{title} {artist}"
        r = _HTTP.get(
            "https://music.163.com/api/search/get",
            params={"s": keyword, "type": 1, "limit": 10},
            headers={"User-Agent": "Mozilla/5.0", "Referer": "https://music.163.com/"},
            timeout=10,
        )
        r.raise_for_status()
        songs = (r.json().get("result", {}) or {}).get("songs", [])
        if not songs:
            return None

        best = None
        for s in songs:
            sname = s.get("name", "")
            sartist_list = [a.get("name", "").lower() for a in s.get("artists", [])]
            artist_lower = artist.lower() if artist else ""

            # Require: song title matches AND at least one artist matches
            title_ok = sname.lower() == title.lower() or title.lower() in sname.lower()
            artist_ok = not artist or any(artist_lower in a or a in artist_lower for a in sartist_list)

            if title_ok and artist_ok:
                # Prefer exact title match over substring
                if sname.lower() == title.lower():
                    return s.get("id")
                best = s.get("id")

            # Also try substring match on artist
            if not best and title.lower() in sname.lower() and artist_ok:
                best = s.get("id")

        return best or songs[0].get("id")
    except Exception as e:
        log.debug(f"search netease error: {e}")
    return None


def _fetch_via_proxy(title, artist, headers):
    """Try Netease Cloud Music via public API proxy."""
    try:
        proxy = "https://netease-cloud-music-api-eta.vercel.app"
        r = _HTTP.get(f"{proxy}/search", params={"keywords": f"{title} {artist}", "limit": 5}, timeout=25)
        r.raise_for_status()
        songs = (r.json().get("result", {}) or {}).get("songs", [])
        if not songs:
            log.debug(f"netease proxy: no search results for '{title} {artist}'")
            return ""
        sid = songs[0].get("id")
        if not sid:
            return ""
        r2 = _HTTP.get(f"{proxy}/lyric", params={"id": sid}, timeout=25)
        r2.raise_for_status()
        d = r2.json()
        lrc = (d.get("lrc", {}) or {}).get("lyric", "")
        if lrc and re.search(r'\[\d+:', lrc):
            return lrc
        log.debug(f"netease proxy: lyric empty for id={sid}, keys={list(d.keys())}")
        return ""
    except Exception as e:
        log.debug(f"netease proxy error: {e}")
        return ""


def _fetch_via_direct(title, artist, headers):
    """Try Netease Cloud Music via direct API (fallback)."""
    try:
        keyword = f"{title} {artist}" if artist else title
        r = _HTTP.get(
            "https://music.163.com/api/search/get",
            params={"s": keyword, "type": 1, "limit": 5},
            headers=headers, timeout=6,
        )
        r.raise_for_status()
        songs = (r.json().get("result", {}) or {}).get("songs", [])
        if not songs:
            return ""
        sid = songs[0].get("id")
        if not sid:
            return ""
        r2 = _HTTP.get(
            f"https://music.163.com/api/song/lyric?id={sid}&lv=1&kv=1&tv=-1",
            headers=headers, timeout=6,
        )
        r2.raise_for_status()
        d = r2.json()
        lrc = (d.get("lrc", {}) or {}).get("lyric", "")
        if lrc and re.search(r'\[\d+:', lrc):
            return lrc
        return ""
    except Exception as e:
        log.debug(f"netease direct error: {e}")
        return ""
    try:
        headers = {
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36",
            "Referer": "https://music.163.com/",
        }
        # Step 1: Search
        keyword = title
        if artist:
            keyword = f"{title} {artist}"
        resp = _HTTP.get(
            "https://music.163.com/api/search/get",
            params={"s": keyword, "type": 1, "limit": 5},
            headers=headers,
            timeout=10,
        )
        resp.raise_for_status()
        data = resp.json()
        songs = (data.get("result", {}) or {}).get("songs", [])
        if not songs:
            return ""

        # Step 2: Find best match and get lyrics
        best_id = None
        for song in songs:
            sid = song.get("id")
            if not sid:
                continue
            sname = song.get("name", "")
            sartists = [a.get("name", "") for a in song.get("artists", [])]
            sartist = ", ".join(sartists)
            # Fuzzy match
            if title.lower() in sname.lower() or sname.lower() in title.lower():
                best_id = sid
                break
            if artist and any(artist.lower() in a.lower() for a in sartists):
                best_id = sid
                break
        if not best_id:
            best_id = songs[0].get("id")

        if not best_id:
            return ""

        # Step 3: Fetch lyrics
        resp2 = _HTTP.get(
            "https://music.163.com/api/song/lyric",
            params={"id": best_id, "lv": 1, "kv": 1, "tv": -1},
            headers=headers,
            timeout=10,
        )
        resp2.raise_for_status()
        lyric_data = resp2.json()
        lrc = (lyric_data.get("lrc", {}) or {}).get("lyric", "")
        if lrc and re.search(r'\[\d+:', lrc):
            return lrc
        # Try translated lyrics as fallback
        tlyric = (lyric_data.get("tlyric", {}) or {}).get("lyric", "")
        if tlyric and re.search(r'\[\d+:', tlyric):
            return tlyric
        return ""
    except Exception as e:
        log.debug(f"fetch_lrc_netease error: {e}")

    # Fallback: try the original Netease API directly
    try:
        headers = {"User-Agent": "Mozilla/5.0", "Referer": "https://music.163.com/"}
        keyword = f"{title} {artist}"
        resp = _HTTP.get(
            "https://music.163.com/api/search/get",
            params={"s": keyword, "type": 1, "limit": 5},
            headers=headers, timeout=10,
        )
        songs = (resp.json().get("result", {}) or {}).get("songs", [])
        if songs:
            sid = songs[0].get("id")
            if sid:
                r2 = _HTTP.get(
                    f"https://music.163.com/api/song/lyric?id={sid}&lv=1&kv=1&tv=-1",
                    headers=headers, timeout=10,
                )
                d = r2.json()
                lrc = (d.get("lrc", {}) or {}).get("lyric", "")
                if lrc and re.search(r'\[\d+:', lrc):
                    return lrc
    except Exception as e:
        log.debug(f"fetch_lrc_netease fallback error: {e}")

    return ""


def parse_lrc(lrc_text):
    """Parse LRC format: [mm:ss.xx]text -> [(time_sec, text), ...] sorted."""
    lines = []
    pattern = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\](.*)")
    for line in lrc_text.strip().split("\n"):
        m = pattern.match(line)
        if m:
            mins = int(m.group(1))
            secs = float(m.group(2))
            text = m.group(3).strip()
            if text:
                lines.append((mins * 60 + secs, text))
    lines.sort()
    return lines


def get_current_line(parsed_lrc, position):
    """Return the last line with timestamp <= position, or first line."""
    if not parsed_lrc:
        return ""
    current = parsed_lrc[0][1]
    for ts, text in parsed_lrc:
        if ts <= position:
            current = text
        else:
            break
    return current


