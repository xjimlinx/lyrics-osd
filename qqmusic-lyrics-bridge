def read_plasmoid_interval():
    """Read refreshInterval from plasmoid's KConfig (if available)."""
    try:
        cfg = configparser.ConfigParser()
        cfgpath = os.path.expanduser("~/.config/plasma-org.kde.plasma.desktop-appletsrc")
        cfg.read(cfgpath)

        # Step 1: find applet ID by plugin name
        applet_id = None
        for sec in cfg.sections():
            if cfg.has_option(sec, "plugin") and cfg.get(sec, "plugin") == "com.github.xein.lyrics-osd":
                # Extract applet ID from section e.g. "Containments][172][Applets][329"
                m = re.search(r"Applets\]\[(\d+)\]?$", sec)
                if m:
                    applet_id = m.group(1)
                    break

        # Step 2: find Configuration/General section for that applet
        if applet_id:
            for sec in cfg.sections():
                if f"Applets][{applet_id}][Configuration][General]" in f"[{sec}]":
                    if cfg.has_option(sec, "refreshInterval"):
                        return int(cfg.get(sec, "refreshInterval"))
    except Exception:
        pass
    return 300


_SOURCE_MAP = ["both", "native", "lrclib", "netease", "lrclib_first", "netease_first"]


def read_plasmoid_lyrics_source():
    """Read lyricsSource from plasmoid's KConfig."""
    try:
        cfg = configparser.ConfigParser()
        cfgpath = os.path.expanduser("~/.config/plasma-org.kde.plasma.desktop-appletsrc")
        cfg.read(cfgpath)

        applet_id = None
        for sec in cfg.sections():
            if cfg.has_option(sec, "plugin") and cfg.get(sec, "plugin") == "com.github.xein.lyrics-osd":
                m = re.search(r"Applets\]\[(\d+)\]?$", sec)
                if m:
                    applet_id = m.group(1)
                    break
        if applet_id:
            for sec in cfg.sections():
                if f"Applets][{applet_id}][Configuration][General]" in f"[{sec}]":
                    if cfg.has_option(sec, "lyricsSource"):
                        return _SOURCE_MAP[int(cfg.get(sec, "lyricsSource"))]
    except Exception:
        pass
    return "both"


